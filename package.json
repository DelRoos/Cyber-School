{
  "name": "cyber-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-first interactive learning academy platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/quality/preflight.ts && turbo run dev",
    "build": "node --experimental-strip-types scripts/quality/preflight.ts && node --experimental-strip-types tests/scripts/validate-governance.ts && turbo run build",
    "lint": "turbo run lint && eslint tests scripts playwright.config.ts eslint.config.mjs",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.checks.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "turbo run test:unit",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:curriculum": "turbo run build --filter=@cyber-school/lesson-runtime && node --experimental-strip-types tests/scripts/validate-curriculum.ts",
    "validate:governance": "node --experimental-strip-types tests/scripts/validate-governance.ts",
    "v4:import": "turbo run build --filter=@cyber-school/lesson-runtime && node --experimental-strip-types scripts/curriculum/v4-import.ts",
    "v4:plan": "node --experimental-strip-types scripts/curriculum/v4-plan.ts",
    "v4:mission": "node --experimental-strip-types scripts/curriculum/v4-mission.ts",
    "v4:audit": "node --experimental-strip-types scripts/curriculum/v4-audit-course.ts",
    "course:workflow": "turbo run build --filter=@cyber-school/lesson-runtime && node --experimental-strip-types scripts/curriculum/course-workflow.ts",
    "course:compile": "turbo run build --filter=@cyber-school/lesson-runtime && node --experimental-strip-types scripts/curriculum/course-compile.ts",
    "course:lint": "turbo run build --filter=@cyber-school/lesson-runtime && node --experimental-strip-types scripts/curriculum/course-compile.ts -- --lint-only",
    "test:guards": "turbo run build --filter=@cyber-school/lesson-runtime && node --experimental-strip-types --test scripts/quality/guards.test.ts scripts/curriculum/v4-pipeline.test.ts scripts/curriculum/course-workflow.test.ts",
    "quality:environment": "node --experimental-strip-types scripts/quality/preflight.ts",
    "quality:checkpoint": "node --experimental-strip-types scripts/quality/checkpoint.ts",
    "quality:verify": "node --experimental-strip-types scripts/quality/run-checks.ts",
    "check:all": "node --experimental-strip-types scripts/quality/run-checks.ts"
  },
  "devDependencies": {
    "@cyber-school/lesson-runtime": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
